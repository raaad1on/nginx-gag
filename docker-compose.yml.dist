services:
  nginx-cdn:
    image: ghcr.io/raaad1on/nginx-gag:cdn-latest
    container_name: nginx-cdn
    network_mode: host
    environment:
      - DOMAIN=example.com
      - XHTTP_PATH=/api/v1/hs/edge/sigments.ts
    volumes:
      # Real TLS certs (same layout as nginx-gag)
      - /etc/nginx/ssl:/etc/nginx/ssl:ro
      # Shared with Xray: expect /dev/shm/nginx/cdn-xhttp.sock
      - /dev/shm/nginx:/dev/shm/nginx
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:9000/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 5s
